# ===== InsurWiki-RAG 环境配置示例 =====
# LLM：智谱 GLM（GLM Coding Plan 走 Anthropic 兼容端点）
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_MODEL=glm-5.3
LLM_MODEL_FALLBACK=glm-4.6
LLM_API_KEY=你的智谱APIKey

EMBED_MODEL=hf_cache/models/bge-small-zh-v1.5（首次可用脚本从 hf-mirror 拉取，或改回 BAAI/bge-small-zh-v1.5 由 HF 自动下载）
RERANK_MODEL=hf_cache/models/bge-reranker-v2-m3（同上，BAAI/bge-reranker-v2-m3）
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=./hf_cache

# 检索参数
RRF_K=60
RERANK_TOP_N=5

# 数据采样规模（1~2k）
DATA_SAMPLE=1500

# 服务端口
PORT=8010
